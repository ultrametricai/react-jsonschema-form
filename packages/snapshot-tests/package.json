{
  "name": "@rjsf/snapshot-tests",
  "version": "6.2.5",
  "description": "A set of snapshot tests to be used for testing RJSF theme.",
  "scripts": {
    "build": "tsc -b .",
    "cs-check": "biome check src",
    "cs-format": "biome check --write src",
    "lint": "biome lint src",
    "precommit": "lint-staged",
    "publish-to-npm": "npm run build && npm publish",
    "test": "echo 'OK'",
    "test-coverage": "echo 'OK'"
  },
  "lint-staged": {
    "src/**/*.[jt]s?(x)": [
      "biome check --write"
    ]
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "dist",
    "lib"
  ],
  "engineStrict": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@rjsf/core": "^6.2.x",
    "@rjsf/utils": "^6.2.x",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@rjsf/core": "*",
    "@rjsf/utils": "*",
    "@rjsf/validator-ajv8": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjsf-team/react-jsonschema-form.git"
  },
  "author": "Nicolas Perriault <nperriault@mozilla.com>",
  "contributors": [
    "Heath Chiavettone <heath.chiavettone@freenome.com"
  ],
  "keywords": [
    "react",
    "form",
    "json-schema"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/rjsf-team/react-jsonschema-form",
  "publishConfig": {
    "access": "public"
  }
}
